POSTGRES_DB=database_name
POSTGRES_DB_CONTAINER_NAME=${POSTGRES_DB}-db
POSTGRES_USER=admin
POSTGRES_PASSWORD=super_secret_password
POSTGRES_PORT=5432

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=super_secret_password
PGADMIN_PORT=5050
# Only needed if you run several pgadmin servers
PGADMIN_CONFIG_SESSION_COOKIE_NAME="'fms_pga4_session'"

# Only needed for the mcp-http docker-compose service / remote HTTP mode.
MCP_TRANSPORT=stdio
MCP_API_KEY=changeme-generate-a-long-random-string
MCP_HTTP_PORT=3000

# @fms/http REST adapter. IDENTITY_SERVICE_URL is identity-service's own
# base URL (its JWKS lives at {IDENTITY_SERVICE_URL}/jwks.json) — for local
# non-Docker dev this is plain localhost; the docker-compose `http` service
# overrides it to host.docker.internal since identity-service runs as a
# separate compose project, not inside this one's network.
IDENTITY_SERVICE_URL=http://localhost:3000
HTTP_PORT=3002
