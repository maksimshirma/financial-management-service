POSTGRES_DB=database_name
POSTGRES_DB_CONTAINER_NAME=${POSTGRES_DB}-db
POSTGRES_USER=admin
POSTGRES_PASSWORD=super_secret_password
POSTGRES_PORT=5432

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=super_secret_password
PGADMIN_PORT=5050

# Only needed for the mcp-http docker-compose service / remote HTTP mode.
MCP_TRANSPORT=stdio
MCP_API_KEY=changeme-generate-a-long-random-string
MCP_HTTP_PORT=3000
